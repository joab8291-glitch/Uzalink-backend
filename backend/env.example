NODE_ENV=development
PORT=10000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/uzalink?schema=public
FRONTEND_URL=https://uzalink.vercel.app
PUBLIC_API_URL=https://YOUR-UZALINK-API.onrender.com
JWT_SECRET=replace-with-a-long-random-secret
COOKIE_NAME=uzalink_session

# Admin bootstrap (used only by prisma seed)
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=UzaLink Admin

# Email / magic links
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=UzaLink <no-reply@example.com>

# M-Pesa Daraja
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_CALLBACK_URL=https://api.example.com/api/orders/mpesa/callback
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
MPESA_B2C_RESULT_URL=https://YOUR-API-DOMAIN/api/payouts/mpesa/result
MPESA_B2C_TIMEOUT_URL=https://YOUR-API-DOMAIN/api/payouts/mpesa/timeout

# Premium plan
PREMIUM_PRICE_KES=500
PREMIUM_DURATION_DAYS=30

# S3-compatible private object storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=uzalink-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Optional SMS provider webhook/endpoint. Keep empty to disable SMS.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
